# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agendapro"

# Auth.js (NextAuth) — generate with `npx auth secret`
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Base URL used to build public booking links (https://app.com/agendar/slug)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# WhatsApp integration (optional — leave empty in development).
# The notification service falls back to a local no-op provider that only
# logs/persists the message when these are not set. See src/lib/whatsapp.
WHATSAPP_PROVIDER=""
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
